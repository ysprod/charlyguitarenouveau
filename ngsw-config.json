{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/ngsw.json",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "core-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/media/**",
          "/*.(eot|svg|cur|otf|ttf|woff|woff2|ani)"
        ]
      }
    },
    {
      "name": "game-assets",
      "installMode": "prefetch",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/assets/games/**",
          "/assets/sounds/**",
          "/assets/sprites/**",
          "/assets/levels/**",
          "/*.(jpg|jpeg|png|webp|gif|svg|mp3|ogg|wav|mp4|webm)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "google-fonts",
      "urls": [
        "https://fonts.googleapis.com/**",
        "https://fonts.gstatic.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 30,
        "maxAge": "365d",
        "timeout": "3s"
      }
    },
    {
      "name": "cdn-libraries",
      "urls": [
        "https://cdnjs.cloudflare.com/**",
        "https://kit.fontawesome.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 50,
        "maxAge": "365d",
        "timeout": "3s"
      }
    },
    {
      "name": "external-images",
      "urls": [
        "https://res.cloudinary.com/**",
        "https://images.unsplash.com/**",
        "https://i.ytimg.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 150,
        "maxAge": "60d",
        "timeout": "5s"
      }
    },
    {
      "name": "firebase-rtdb",
      "urls": [
        "https://*.firebaseio.com/**",
        "https://*.firebasedatabase.app/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "1h",
        "timeout": "5s"
      }
    },
    {
      "name": "firestore-rest",
      "urls": [
        "https://firestore.googleapis.com/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "1h",
        "timeout": "5s"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ]
}