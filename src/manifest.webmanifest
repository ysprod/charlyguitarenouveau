{
  "id": "/?source=pwa",
  "name": "Charly Guitare — Académie & Live",
  "short_name": "CharlyGuitare",
  "description": "Apprends la guitare, joue en live et explore Offoland. Cours, jeux, outils et communauté pour guitaristes passionnés.",
  "lang": "fr",
  "dir": "ltr",

  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",

  "theme_color": "#ea580c",
  "background_color": "#ffffff",

  "categories": ["education", "music", "entertainment", "games"],
  "iarc_rating_id": "",

  "icons": [
