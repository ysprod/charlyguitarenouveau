      "description": "Accéder à la bibliothèque de jeux",
      "url": "/play?source=pwa",
      "icons": [
        {
          "src": "assets/icons/shortcut-play-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Live",
      "short_name": "Live",
      "description": "Rejoindre le mode live",
      "url": "/live?source=pwa",
      "icons": [
        {
          "src": "assets/icons/shortcut-live-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Académie",
      "short_name": "Académie",
      "description": "Cours et formations",
      "url": "/academie?source=pwa",
      "icons": [
        {
          "src": "assets/icons/shortcut-academie-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mes messages",
      "short_name": "Inbox",
