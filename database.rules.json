{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".indexOn": ["role", "origine", "email", "lastLogin", "createdAt"],
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
        "uid": {
          ".write": "auth != null && root.child('administrators').child(auth.uid).exists()"
        },
        "role": {
          ".write": "auth != null && root.child('administrators').child(auth.uid).exists()"
        },
        "disabled": {
          ".write": "auth != null && root.child('administrators').child(auth.uid).exists()"
        }
      }
    },
    "administrators": {
      ".indexOn": ["email", "role", "promotedAt"],
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      ".write": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
        ".write": "auth != null && root.child('administrators').child(auth.uid).exists()"
      }
    },
    "messages": {
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
        "inbox": {
          ".indexOn": ["threadId", "createdAt", "from", "read"],
          ".read": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
          "$messageId": {
            ".write": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists() || (!data.exists() && newData.child('from').val() === auth.uid))"
          }
        },
        "sent": {
          ".indexOn": ["threadId", "createdAt", "to"],
          ".read": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
          "$messageId": {
            ".write": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())"
          }
        }
      },
      "support": {
        "inbox": {
          "$messageId": {
            ".write": "!data.exists() && newData.exists() && newData.child('source').val() === 'help-page' && newData.child('to').val() === 'support'",
            ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['subject', 'body', 'fromName', 'fromEmail', 'createdAt']) && newData.child('body').isString() && newData.child('body').val().length <= 5000 && newData.child('subject').isString() && newData.child('subject').val().length <= 200"
          }
        }
      }
    },
    "notifications": {
      ".indexOn": ["read", "createdAt", "type"],
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$uid": {
        ".indexOn": ["read", "createdAt", "type"],
        ".read": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
        ".write": "auth != null && root.child('administrators').child(auth.uid).exists()",
        "$notifId": {
          ".write": "auth != null && (root.child('administrators').child(auth.uid).exists() || (auth.uid === $uid && data.exists() && newData.exists() && newData.child('userId').val() === data.child('userId').val() && newData.child('type').val() === data.child('type').val() && newData.child('title').val() === data.child('title').val() && newData.child('body').val() === data.child('body').val() && newData.child('createdAt').val() === data.child('createdAt').val()))"
        }
      }
    },
    "admin_notifications": {
      ".indexOn": ["read", "createdAt"],
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      ".write": "auth != null && root.child('administrators').child(auth.uid).exists()"
    },
    "documents": {
      ".indexOn": ["type", "level", "createdAt"],
      ".read": "auth != null",
      ".write": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$docId": {
        ".read": "auth != null && (root.child('administrators').child(auth.uid).exists() || (data.child('priceXof').isNumber() && data.child('priceXof').val() > 0))"
      }
    },
    "archives": {
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      ".write": "auth != null && root.child('administrators').child(auth.uid).exists()",
      ".validate": "newData.hasChildren(['type', 'title', 'archivedAt', 'originalData'])"
    },
    "orders": {
      ".indexOn": ["status", "userId", "createdAt", "paidAt", "orderType", "paymentMethod"],
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      ".write": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$orderId": {
        ".read": "auth != null && (root.child('administrators').child(auth.uid).exists() || (data.exists() && data.child('userId').val() === auth.uid))",
        ".write": "auth != null && root.child('administrators').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['userId', 'amountXof', 'status', 'reference', 'createdAt']) && newData.child('amountXof').isNumber() && newData.child('amountXof').val() >= 0 && newData.child('status').isString() && newData.child('reference').isString()"
      }
    },
    "orderReferences": {
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      ".write": "auth != null && root.child('administrators').child(auth.uid).exists()"
    },
    "ordersByUser": {
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
        ".write": "auth != null && root.child('administrators').child(auth.uid).exists()"
      }
    },
    "entitlements": {
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
        ".write": "auth != null && root.child('administrators').child(auth.uid).exists()"
      }
    },
    "processedJekoTransactions": {
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      ".write": "auth != null && root.child('administrators').child(auth.uid).exists()"
    },
    "coursePackEntitlements": {
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('administrators').child(auth.uid).exists())",
        ".write": "auth != null && root.child('administrators').child(auth.uid).exists()"
      }
    },
    "coursePackFulfillments": {
      ".indexOn": ["status", "userId", "orderId"],
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      ".write": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$fulfillmentId": {
        ".read": "auth != null && root.child('administrators').child(auth.uid).exists()"
      }
    },
    "gameStats": {
      ".indexOn": ["gameId", "plays", "userId"],
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$statId": {
        ".read": "auth != null && (root.child('administrators').child(auth.uid).exists() || data.child('userId').val() === auth.uid)",
        ".write": "auth != null && (root.child('administrators').child(auth.uid).exists() || (!data.exists() && newData.child('userId').val() === auth.uid))"
      }
    },
    "contacts": {
      ".indexOn": ["createdAt", "userId"],
      ".read": "auth != null && root.child('administrators').child(auth.uid).exists()",
      "$contactId": {
        ".read": "auth != null && (root.child('administrators').child(auth.uid).exists() || data.child('userId').val() === auth.uid)",
        ".write": "auth != null && (root.child('administrators').child(auth.uid).exists() || (!data.exists() && newData.exists() && newData.child('userId').val() === auth.uid))"
      }
    }
  }
}